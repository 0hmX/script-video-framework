Set Shell "zsh"
Set Width 1280
Set Height 640
Set FontSize 28
Set FontFamily "Geist Mono"
Set LineHeight 1.1
Set Padding 18
Set Framerate 30
Set TypingSpeed 45ms
Set Theme { "name": "Editorial Mono", "black": "#0a0a0a", "red": "#b8b8b8", "green": "#dedede", "yellow": "#c8c8c8", "blue": "#e8e8e8", "magenta": "#c0c0c0", "cyan": "#d5d5d5", "white": "#f5f5f5", "brightBlack": "#666666", "brightRed": "#d0d0d0", "brightGreen": "#ffffff", "brightYellow": "#e0e0e0", "brightBlue": "#ffffff", "brightMagenta": "#dddddd", "brightCyan": "#eeeeee", "brightWhite": "#ffffff", "background": "#0a0a0a", "foreground": "#dedede", "selectionBackground": "#303030", "cursorColor": "#ffffff" }

Hide
Type `export HOME="$PWD/.video/vhs-home"; mkdir -p "$HOME/Documents/tscircuits/script-video-framework/examples/board"; cp editor/board-before.circuit.tsx "$HOME/Documents/tscircuits/script-video-framework/examples/board/board.circuit.tsx"; clear; cd "$HOME/Documents/tscircuits/script-video-framework"; nvim -u "$OLDPWD/editor/nvim.lua" -n -i NONE examples/board/board.circuit.tsx`
Enter
Sleep 1.5s
Show

Sleep 700ms
Type@60ms "jjjjjjjjjjjj"
Sleep 300ms
Type "o"
Type@32ms "<silkscreentext"
Enter
Type@32ms `  text="tscircuit <board>"`
Enter
Type@32ms "pcbX={0}"
Enter
Type@32ms "pcbY={0}"
Enter
Type@32ms "fontSize={2.4}"
Enter
Ctrl+D
Type@32ms "/>"
Sleep 300ms
Escape
Sleep 350ms
Type ":w"
Enter
Sleep 1.2s
