Set Shell "zsh"
Set Width 1280
Set Height 800
Set FontSize 24
Set FontFamily "Geist Mono"
Set LineHeight 1.12
Set Padding 24
Set Framerate 30
Set TypingSpeed 35ms
Set Theme { "name": "Editorial Mono", "black": "#0a0a0a", "red": "#b8b8b8", "green": "#dedede", "yellow": "#c8c8c8", "blue": "#e8e8e8", "magenta": "#c0c0c0", "cyan": "#d5d5d5", "white": "#f5f5f5", "brightBlack": "#666666", "brightRed": "#d0d0d0", "brightGreen": "#ffffff", "brightYellow": "#e0e0e0", "brightBlue": "#ffffff", "brightMagenta": "#dddddd", "brightCyan": "#eeeeee", "brightWhite": "#ffffff", "background": "#0a0a0a", "foreground": "#dedede", "selectionBackground": "#303030", "cursorColor": "#ffffff" }

Hide
Type `export PS1='$ '; export TSCI_SKIP_CLI_UPDATE=true; export HOME="/tmp/tsci-video"; mkdir -p "$HOME/Documents/tscircuits"; cd "$HOME/Documents/tscircuits"; rm -rf "$HOME/Documents/tscircuits/kicad-people-demo"; clear`
Enter
Show
Sleep 600ms
Type "tsci init kicad-people-demo --no-install"
Enter
Sleep 900ms
Enter
Sleep 900ms
Type "n"
Enter
Sleep 3s
Type "cd kicad-people-demo"
Enter
Type "ls -la"
Enter
Sleep 2s
