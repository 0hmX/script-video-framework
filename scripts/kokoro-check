#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "$0")/.." && pwd)"
export HF_HOME="${KOKORO_HF_HOME:-$root/.models/kokoro}"
export HF_HUB_OFFLINE=1
exec "$root/.venv-kokoro/bin/python" -c 'from kokoro import KPipeline; p=KPipeline(lang_code="a", repo_id="hexgrad/Kokoro-82M", device="cpu"); p.load_voice("af_heart"); print("Kokoro 0.9.4 · af_heart · native timestamps")'
